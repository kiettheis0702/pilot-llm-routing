# Consistent text files across Windows, Linux, and macOS
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary research assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.pptx binary
*.zip binary
*.gz binary
*.npy binary
*.npz binary
*.pkl binary
*.pickle binary
*.parquet binary
*.arrow binary
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary

# Preserve exact bytes of already-frozen research identities and evidence.
# Their hashes identify completed local runs; newline conversion breaks replay.
configs/model_mapping.json -text
configs/frozen_experiment_protocol.json -text
configs/research_prior_index.json -text
tools/research/verify_replicate.py -text
reports/full-experiments-2026-10-29/** -text
configs/course_analysis_protocol.json -text
tools/course/** -text
# Frozen course evidence includes CRLF; recognize it without changing bytes.
reports/course-submission-2026-10-30/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve the byte identities of the new frozen OpenAI/Instructor evidence.
configs/openai_core_protocol.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/paper_preflight_protocol.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/followup_assets.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/followup_source_audit_manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/followup-neural-requirements.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/openai-*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/instructor-*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/paper-preflight-*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/frozen_sources/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Generated SVG paths and captured tracebacks retain their producer formatting.
reports/openai-*/**/*.svg -text -whitespace
reports/instructor-*/**/*.svg -text -whitespace
reports/openai-core-2026-10-31/evidence/*.log -text -whitespace

# Keep generated scientific evidence collapsed in GitHub reviews.
reports/openai-*/** linguist-generated=true
reports/instructor-*/** linguist-generated=true
reports/paper-preflight-*/** linguist-generated=true
